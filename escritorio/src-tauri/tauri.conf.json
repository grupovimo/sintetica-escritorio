{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sintética",
  "version": "0.1.0",
  "identifier": "com.sinteticalabs.escritorio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "cara",
        "title": "Sintética",
        "url": "index.html",
        "width": 280,
        "height": 151,
        "minWidth": 160,
        "minHeight": 86,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "Productivity",
    "shortDescription": "El robot que vive en la compu",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
